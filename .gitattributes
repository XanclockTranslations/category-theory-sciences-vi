# LF in Git and in working trees on Windows, macOS and Linux.
* text=auto eol=lf
*.py text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
LICENSE text eol=lf

# Native line endings for future Windows batch scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve binary bytes in book, artwork, font and archive files.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
